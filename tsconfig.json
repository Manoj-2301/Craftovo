{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/Components/*": ["./src/app/resources/components/*"],
      "@/components/*": ["./src/app/resources/components/*"],
      "@/Utils/*": ["./src/app/resources/components/utilis/*"],
      "@/utilis/*": ["./src/app/resources/components/utilis/*"],
      "@/Styles/*": ["./src/app/resources/styles/*"],
      "@/styles/*": ["./src/app/resources/styles/*"],
      "@/styles": ["./src/app/resources/styles/globals.scss"],
      "@/Models/*": ["./src/app/resources/models/*"],
      "@/models/*": ["./src/app/resources/models/*"],
      "@/Config/*": ["./src/app/resources/config/*"],
      "@/config/*": ["./src/app/resources/config/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
